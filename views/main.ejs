<head>
    <title>Control Panel | Nginx Virtual Host Management System</title>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Prompt:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap');

        :root {
            --bg-body: #0d1117;
            --bg-sidebar: #010409;
            --bg-card: #161b22;
            --bg-input: #0d1117;
            --border-color: #30363d;
            --accent-blue: #58a6ff;
            --accent-green: #3fb950;
            --accent-yellow: #d29922;
            --accent-red: #f85149;
            --text-main: #c9d1d9;
            --text-heading: #f0f6fc;
            --text-muted: #8b949e;
            --sidebar-width: 250px;
        }

        * {
            font-family: 'Prompt', sans-serif;
        }

        html,
        body {
            min-height: 100%;
        }

        body {
            margin: 0;
            background: var(--bg-body) !important;
            color: var(--text-main);
        }

        /* =========================================
           SIDEBAR
        ========================================= */

        .control-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: var(--sidebar-width);
            height: 100vh;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border-color);
            z-index: 1050;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            height: 72px;
            padding: 0 20px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--border-color);
        }

        .sidebar-brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(88, 166, 255, 0.12);
            color: var(--accent-blue);
            margin-right: 12px;
        }

        .sidebar-brand-title {
            color: var(--text-heading);
            font-size: 15px;
            font-weight: 600;
            line-height: 1.2;
        }

        .sidebar-brand-subtitle {
            color: var(--text-muted);
            font-size: 11px;
            margin-top: 2px;
        }

        .sidebar-menu {
            padding: 18px 12px;
            overflow-y: auto;
            flex: 1;
        }

        .sidebar-section-title {
            color: #6e7681;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            padding: 0 12px;
            margin: 12px 0 8px;
        }

        .sidebar-link {
            width: 100%;
            border: 0;
            background: transparent;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            text-align: left;
            padding: 10px 12px;
            border-radius: 8px;
            margin-bottom: 3px;
            font-size: 13px;
            transition: all 0.15s ease;
            cursor: pointer;
        }

        .sidebar-link i {
            width: 22px;
            margin-right: 10px;
            font-size: 14px;
            text-align: center;
        }

        .sidebar-link:hover {
            color: var(--text-heading);
            background: rgba(255, 255, 255, 0.05);
        }

        .sidebar-link.active {
            color: #ffffff;
            background: rgba(88, 166, 255, 0.14);
            box-shadow: inset 3px 0 0 var(--accent-blue);
        }

        .sidebar-link.active i {
            color: var(--accent-blue);
        }

        .sidebar-footer {
            padding: 14px;
            border-top: 1px solid var(--border-color);
        }

        .server-status {
            background: rgba(63, 185, 80, 0.08);
            border: 1px solid rgba(63, 185, 80, 0.2);
            border-radius: 8px;
            padding: 10px 12px;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            background: var(--accent-green);
            border-radius: 50%;
            display: inline-block;
            margin-right: 7px;
            box-shadow: 0 0 8px rgba(63, 185, 80, 0.5);
        }

        /* =========================================
           MAIN CONTENT
        ========================================= */

        .control-main {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
        }

        .topbar {
            height: 72px;
            border-bottom: 1px solid var(--border-color);
            background: rgba(13, 17, 23, 0.9);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            padding: 0 28px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .topbar-title {
            color: var(--text-heading);
            font-size: 18px;
            font-weight: 600;
        }

        .topbar-subtitle {
            color: var(--text-muted);
            font-size: 12px;
        }

        .content-wrapper {
            padding: 28px;
        }

        /* =========================================
           CARDS
        ========================================= */

        .card {
            background-color: var(--bg-card) !important;
            border: 1px solid var(--border-color) !important;
            border-radius: 12px !important;
            color: var(--text-main) !important;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        }

        .card-header {
            background-color: rgba(255, 255, 255, 0.02) !important;
            border-bottom: 1px solid var(--border-color) !important;
            color: var(--text-heading) !important;
            font-weight: 600;
        }

        .stat-card {
            background-color: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 16px;
            height: 100%;
        }

        .stat-card.h-max {
            height: max-content;
        }

        .stat-value {
            color: #ffffff;
            font-size: 20px;
            font-weight: 600;
        }

        .section-title {
            color: var(--text-heading);
            font-size: 14px;
            font-weight: 600;
        }

        .section-subtitle {
            color: var(--text-muted);
            font-size: 12px;
        }

        /* =========================================
           FORM
        ========================================= */

        .form-control,
        .form-select {
            background-color: var(--bg-input) !important;
            color: var(--text-heading) !important;
            border: 1px solid var(--border-color) !important;
            border-radius: 8px;
            padding: 0.6rem 0.9rem;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--accent-blue) !important;
            box-shadow: 0 0 0 0.25rem rgba(88, 166, 255, 0.15) !important;
        }

        .form-control::placeholder {
            color: #6e7681 !important;
        }

        .form-label {
            color: var(--text-muted);
        }

        /* =========================================
           BUTTONS
        ========================================= */

        .btn {
            border-radius: 8px;
        }

        .btn-primary {
            background-color: #238636;
            border-color: #238636;
        }

        .btn-primary:hover {
            background-color: #2ea043;
            border-color: #2ea043;
        }

        /* =========================================
           LOADER
        ========================================= */

        .loader {
            width: 50px;
            aspect-ratio: 4;
            --_g: no-repeat radial-gradient(circle closest-side,
                    var(--accent-blue) 90%,
                    #0000);

            background:
                var(--_g) 0% 50%,
                var(--_g) 50% 50%,
                var(--_g) 100% 50%;

            background-size: calc(100% / 3) 100%;
            animation: l7 1s infinite linear;
            margin: 30px auto;
        }

        @keyframes l7 {
            33% {
                background-size:
                    calc(100% / 3) 0%,
                    calc(100% / 3) 100%,
                    calc(100% / 3) 100%;
            }

            50% {
                background-size:
                    calc(100% / 3) 100%,
                    calc(100% / 3) 0%,
                    calc(100% / 3) 100%;
            }

            66% {
                background-size:
                    calc(100% / 3) 100%,
                    calc(100% / 3) 100%,
                    calc(100% / 3) 0%;
            }
        }

        /* =========================================
           MOBILE
        ========================================= */

        .mobile-menu-button {
            display: none;
        }

        @media screen and (max-width: 991px) {

            .control-sidebar {
                transform: translateX(-100%);
                transition: transform 0.2s ease;
            }

            .control-sidebar.show {
                transform: translateX(0);
            }

            .control-main {
                margin-left: 0;
            }

            .mobile-menu-button {
                display: inline-flex;
            }

            .topbar {
                padding: 0 16px;
            }

            .content-wrapper {
                padding: 18px;
            }

            .sidebar-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, 0.55);
                z-index: 1040;
            }

            .sidebar-overlay.show {
                display: block;
            }
        }

        @media screen and (max-width: 576px) {

            .content-wrapper {
                padding: 12px;
            }

            .topbar-title {
                font-size: 15px;
            }

            .topbar-subtitle {
                display: none;
            }
        }

        @media screen and (max-width: 1024px) {
            table {
                width: max-content;
            }
        }
    </style>

    <%-include('include/head')%>
</head>

<body>

    <!-- =========================================
         SIDEBAR
    ========================================== -->

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <aside class="control-sidebar" id="controlSidebar">

        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">
                <i class="fa-solid fa-server"></i>
            </div>

            <div>
                <div class="sidebar-brand-title">
                    Nginx Control
                </div>

                <div class="sidebar-brand-subtitle">
                    Web Server Management
                </div>
            </div>
        </div>

        <div class="sidebar-menu">

            <div class="sidebar-section-title">
                Dashboard
            </div>

            <button class="sidebar-link active" data-section="overview" onclick="switchSection('overview', this)">
                <i class="fa-solid fa-chart-line"></i>
                Overview
            </button>

            <div class="sidebar-section-title">
                Server
            </div>

            <button class="sidebar-link" data-section="ports" onclick="switchSection('ports', this)">
                <i class="fa-solid fa-network-wired"></i>
                Used Ports
            </button>

            <button class="sidebar-link" data-section="webroot" onclick="switchSection('webroot', this)">
                <i class="fa-solid fa-folder-tree"></i>
                Web Root
            </button>

            <div class="sidebar-section-title">
                Applications
            </div>

            <button class="sidebar-link" data-section="vhosts" onclick="switchSection('vhosts', this)">
                <i class="fa-solid fa-globe"></i>
                Virtual Hosts
            </button>

            <button class="sidebar-link" data-section="nodeapps" onclick="switchSection('nodeapps', this)">
                <i class="fa-brands fa-node-js"></i>
                Node.js Apps
            </button>

            <div class="sidebar-section-title">
                Management
            </div>

            <button class="sidebar-link" data-section="create" onclick="switchSection('create', this)">
                <i class="fa-solid fa-plus"></i>
                Create Virtual Host
            </button>

        </div>

        <div class="sidebar-footer">

            <div class="server-status">
                <div class="small text-white">
                    <span class="status-dot"></span>
                    Server Online
                </div>

                <div class="small text-secondary mt-1">
                    Nginx Control Panel
                </div>
            </div>

        </div>

    </aside>


    <!-- =========================================
         MAIN
    ========================================== -->

    <main class="control-main">

        <!-- Topbar -->

        <header class="topbar">

            <button class="btn btn-outline-secondary mobile-menu-button me-3" id="mobileMenuButton">
                <i class="fa-solid fa-bars"></i>
            </button>

            <div>

                <div class="topbar-title" id="pageTitle">
                    System Overview
                </div>

                <div class="topbar-subtitle">
                    Monitor and manage your Nginx server
                </div>

            </div>

        </header>


        <div class="content-wrapper">

            <!-- =========================================
                 ALERT
            ========================================== -->

            <%if(locals.alert) {%>

            <div class="alert alert-success alert-dismissible fade show border-0 bg-success bg-opacity-20 mb-4"
                role="alert">

                <i class="fa-solid fa-circle-check me-2"></i>

                <%=alert%>

                <script>
                    function removeAlert() {
                        window.history.replaceState(
                            null,
                            '',
                            window.location.pathname
                        );
                    }
                </script>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"
                    onclick="removeAlert()"></button>

            </div>

            <%}%>


            <!-- =========================================
                 OVERVIEW
            ========================================== -->

            <section
                class="control-section"
                id="section-overview"
            >

                <div class="mb-4">

                    <div class="section-title mb-1">
                        <i class="fa-solid fa-chart-line me-2 text-primary"></i>
                        System Overview
                    </div>

                    <div class="section-subtitle">
                        Real-time server resource monitoring
                    </div>

                </div>


                <div class="row g-3 mb-4">

                    <!-- CPU -->

                    <div class="col-lg-4">

                        <div class="stat-card">

                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <div class="text-secondary small">

                                    <i class="fa-solid fa-microchip me-2 text-info"></i>

                                    CPU Usage

                                </div>

                                <div
                                    class="fs-6 fw-bold text-white"
                                    id="cpuStat"
                                >
                                    Loading...
                                </div>

                            </div>

                            <div style="height: 185px;">
                                <canvas id="cpuChart"></canvas>
                            </div>

                        </div>

                    </div>


                    <!-- MEMORY -->

                    <div class="col-lg-4">

                        <div class="stat-card">

                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <div class="text-secondary small">

                                    <i class="fa-solid fa-memory me-2 text-warning"></i>

                                    Memory Usage

                                </div>

                                <div
                                    class="fs-6 fw-bold text-white"
                                    id="memStat"
                                >
                                    Loading...
                                </div>

                            </div>

                            <div
                                class="small text-secondary mb-2"
                                id="memDetail"
                            >
                                Loading...
                            </div>

                            <div style="height: 155px;">
                                <canvas id="memoryChart"></canvas>
                            </div>

                        </div>

                    </div>


                    <!-- SYSTEM -->

                    <div class="col-lg-4">

                        <div class="stat-card h-max mb-3">

                            <div class="text-secondary small mb-1">

                                <i class="fa-regular fa-clock me-2 text-success"></i>

                                System Uptime

                            </div>

                            <div
                                class="fs-5 fw-bold text-white"
                                id="uptime"
                            >
                                Loading...
                            </div>

                        </div>


                        <div class="stat-card h-max">

                            <div class="text-secondary small mb-3">

                                <i class="fa-solid fa-power-off me-2 text-primary"></i>

                                Action Controls

                            </div>

                            <div class="row g-2">

                                <div class="col-12">

                                    <button
                                        class="btn btn-primary w-100 py-2 fw-medium"
                                        onclick="restartNginx()"
                                    >

                                        <i class="fa-solid fa-arrows-rotate me-2"></i>

                                        Restart Web Server

                                    </button>

                                </div>

                                <div class="col-12">

                                    <button
                                        class="btn btn-outline-danger w-100 py-2 fw-medium"
                                        onclick="stopNginx()"
                                    >

                                        <i class="fa-solid fa-power-off me-2"></i>

                                        Stop Web Server

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Quick Actions -->

                <div class="card">

                    <div class="card-body p-4">

                        <div class="section-title mb-1">
                            Quick Actions
                        </div>

                        <div class="section-subtitle mb-3">
                            Frequently used server management actions
                        </div>

                        <div class="d-flex flex-wrap gap-2">

                            <button
                                class="btn btn-outline-light btn-sm"
                                onclick="switchSectionByName('ports')"
                            >
                                <i class="fa-solid fa-network-wired me-2 text-warning"></i>
                                View Ports
                            </button>

                            <button
                                class="btn btn-outline-light btn-sm"
                                onclick="switchSectionByName('vhosts')"
                            >
                                <i class="fa-solid fa-globe me-2 text-primary"></i>
                                Virtual Hosts
                            </button>

                            <button
                                class="btn btn-outline-light btn-sm"
                                onclick="switchSectionByName('nodeapps')"
                            >
                                <i class="fa-brands fa-node-js me-2 text-success"></i>
                                Node.js Apps
                            </button>

                            <button
                                class="btn btn-outline-light btn-sm"
                                onclick="switchSectionByName('create')"
                            >
                                <i class="fa-solid fa-plus me-2"></i>
                                Create VHost
                            </button>

                        </div>

                    </div>

                </div>

            </section>


            <!-- =========================================
                 USED PORTS
            ========================================== -->

            <section
                class="control-section d-none"
                id="section-ports"
            >

                <div class="mb-4">

                    <div class="section-title mb-1">
                        <i class="fa-solid fa-network-wired me-2 text-warning"></i>
                        Used Ports
                    </div>

                    <div class="section-subtitle">
                        Ports currently being used by services on this server
                    </div>

                </div>


                <div class="card">

                    <div
                        class="card-body p-4"
                        id="used_ports"
                    >

                        <div class="loader"></div>

                    </div>

                </div>

            </section>


            <!-- =========================================
                 WEB ROOT
            ========================================== -->

            <section
                class="control-section d-none"
                id="section-webroot"
            >

                <div class="mb-4">

                    <div class="section-title mb-1">
                        <i class="fa-solid fa-folder-tree me-2 text-info"></i>
                        Web Root Browser
                    </div>

                    <div class="section-subtitle">
                        Browse files under your web server directories
                    </div>

                </div>


                <div class="card">

                    <div
                        class="card-body p-4"
                        id="WebRootBrowser"
                    >

                        <div class="loader"></div>

                    </div>

                </div>

            </section>


            <!-- =========================================
                 VIRTUAL HOSTS
            ========================================== -->

            <section
                class="control-section d-none"
                id="section-vhosts"
            >

                <div class="mb-4">

                    <div class="section-title mb-1">
                        <i class="fa-solid fa-globe me-2 text-primary"></i>
                        Virtual Hosts
                    </div>

                    <div class="section-subtitle">
                        Manage Nginx virtual host configurations
                    </div>

                </div>


                <div
                    class="card p-4"
                    id="VirtualHostsList"
                >

                    <div class="loader"></div>

                </div>

            </section>


            <!-- =========================================
                 NODE APPS
            ========================================== -->

            <section
                class="control-section d-none"
                id="section-nodeapps"
            >

                <div class="mb-4">

                    <div class="section-title mb-1">
                        <i class="fa-brands fa-node-js me-2 text-success"></i>
                        Node.js Applications
                    </div>

                    <div class="section-subtitle">
                        Manage Node.js applications running with PM2
                    </div>

                </div>


                <div class="card">

                    <div
                        class="card-body p-4"
                        id="NodeAppsList"
                    >

                        <div class="loader"></div>

                    </div>

                </div>

            </section>


            <!-- =========================================
                 CREATE VHOST
            ========================================== -->

            <section
                class="control-section d-none"
                id="section-create"
            >

                <div class="mb-4">

                    <div class="section-title mb-1">
                        <i class="fa-solid fa-plus me-2 text-primary"></i>
                        Create Virtual Host
                    </div>

                    <div class="section-subtitle">
                        Create a new Node.js or PHP Nginx virtual host
                    </div>

                </div>


                <div class="row g-4">

                    <!-- NODE -->

                    <div class="col-lg-6">

                        <div class="card h-100">

                            <div class="card-header p-3">

                                <h5 class="m-0 fw-bold">

                                    <i class="fa-brands fa-node-js text-success me-2"></i>

                                    Node.js Virtual Host

                                </h5>

                            </div>

                            <div class="card-body p-4">

                                <form
                                    action="/createNodeJSVirtualHost"
                                    method="post"
                                >

                                    <h6 class="text-primary mb-3">
                                        <i class="fa-solid fa-globe me-2"></i>
                                        App Settings
                                    </h6>

                                    <div class="row g-3 mb-3">

                                        <div class="col-md-6">

                                            <label class="form-label small">
                                                App name:
                                            </label>

                                            <input
                                                type="text"
                                                class="form-control"
                                                name="app_name"
                                                placeholder="my-node-app"
                                                required
                                            >

                                        </div>


                                        <div class="col-md-6">

                                            <label class="form-label small">
                                                Port:
                                            </label>

                                            <input
                                                type="number"
                                                class="form-control"
                                                name="port"
                                                placeholder="3000"
                                                required
                                            >

                                        </div>


                                        <div class="col-md-6">

                                            <label class="form-label small">
                                                Server Name:
                                            </label>

                                            <input
                                                type="text"
                                                class="form-control"
                                                name="server_name"
                                                placeholder="app.example.com"
                                                required
                                            >

                                        </div>


                                        <div class="col-md-6">

                                            <label class="form-label small">
                                                Node.js Path:
                                            </label>

                                            <input
                                                type="text"
                                                class="form-control"
                                                name="app_path"
                                                placeholder="/var/www/node-app"
                                            >

                                        </div>

                                    </div>


                                    <h6 class="text-primary my-3">

                                        <i class="fa-solid fa-hard-drive me-2"></i>

                                        Resources

                                    </h6>


                                    <div class="mb-3">

                                        <label class="form-label small">
                                            Resource Folders:
                                        </label>

                                        <input
                                            type="text"
                                            class="form-control"
                                            name="folders"
                                            placeholder="css,js,images,videos"
                                        >

                                    </div>


                                    <h6 class="text-primary my-3">

                                        <i class="fa-solid fa-shield-halved me-2"></i>

                                        SSL Settings

                                    </h6>


                                    <div class="form-check mb-2">

                                        <input
                                            type="checkbox"
                                            class="form-check-input bg-dark border-secondary"
                                            value="true"
                                            name="ssl_enabled"
                                            id="node_ssl"
                                        >

                                        <label
                                            class="form-check-label small text-secondary"
                                            for="node_ssl"
                                        >
                                            Enable SSL
                                        </label>

                                    </div>


                                    <div class="mb-4">

                                        <label class="form-label small">
                                            SSL File Name:
                                        </label>

                                        <input
                                            type="text"
                                            class="form-control"
                                            name="ssl_file_name"
                                            placeholder="e.g. example_com"
                                        >

                                    </div>


                                    <button
                                        type="submit"
                                        class="btn btn-primary w-100 py-2"
                                    >

                                        <i class="fa-solid fa-plus me-2"></i>

                                        Create Node.js Virtual Host

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>


                    <!-- PHP -->

                    <div class="col-lg-6">

                        <div class="card h-100">

                            <div class="card-header p-3">

                                <h5 class="m-0 fw-bold">

                                    <i class="fa-brands fa-php text-info me-2"></i>

                                    PHP Virtual Host

                                </h5>

                            </div>

                            <div class="card-body p-4">

                                <form
                                    action="/createPHPVirtualHost"
                                    method="post"
                                >

                                    <h6 class="text-primary mb-3">

                                        <i class="fa-solid fa-globe me-2"></i>

                                        App Settings

                                    </h6>


                                    <div class="row g-3 mb-3">

                                        <div class="col-md-6">

                                            <label class="form-label small">
                                                App name:
                                            </label>

                                            <input
                                                type="text"
                                                class="form-control"
                                                name="app_name"
                                                placeholder="my-php-app"
                                                required
                                            >

                                        </div>


                                        <div class="col-md-6">

                                            <label class="form-label small">
                                                PHP Version:
                                            </label>

                                            <input
                                                type="text"
                                                class="form-control"
                                                name="php_version"
                                                placeholder="8.1"
                                                required
                                            >

                                        </div>


                                        <div class="col-12">

                                            <label class="form-label small">
                                                Server Name:
                                            </label>

                                            <input
                                                type="text"
                                                class="form-control"
                                                name="server_name"
                                                placeholder="php.example.com"
                                                required
                                            >

                                        </div>


                                        <div class="col-12">

                                            <label class="form-label small">
                                                Root Directory:
                                            </label>

                                            <input
                                                type="text"
                                                class="form-control"
                                                name="root_dir"
                                                placeholder="/var/www/html/my-app"
                                                required
                                            >

                                        </div>

                                    </div>


                                    <h6 class="text-primary my-3">

                                        <i class="fa-solid fa-shield-halved me-2"></i>

                                        SSL Settings

                                    </h6>


                                    <div class="form-check mb-2">

                                        <input
                                            type="checkbox"
                                            class="form-check-input bg-dark border-secondary"
                                            value="true"
                                            name="ssl_enabled"
                                            id="php_ssl"
                                        >

                                        <label
                                            class="form-check-label small text-secondary"
                                            for="php_ssl"
                                        >
                                            Enable SSL
                                        </label>

                                    </div>


                                    <div class="mb-4">

                                        <label class="form-label small">
                                            SSL File Name:
                                        </label>

                                        <input
                                            type="text"
                                            class="form-control"
                                            name="ssl_file_name"
                                            placeholder="e.g. example_com"
                                        >

                                    </div>


                                    <button
                                        type="submit"
                                        class="btn btn-primary w-100 py-2"
                                    >

                                        <i class="fa-solid fa-plus me-2"></i>

                                        Create PHP Virtual Host

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>

            </section>

        </div>

    </main>


    <!-- =========================================
         SCRIPTS
    ========================================== -->

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        /* =========================================
           SIDEBAR NAVIGATION
        ========================================== */

        const sectionTitles = {

            overview: 'System Overview',

            ports: 'Used Ports',

            webroot: 'Web Root Browser',

            vhosts: 'Virtual Hosts',

            nodeapps: 'Node.js Applications',

            create: 'Create Virtual Host'

        };


        function switchSection(section, button) {

            document
                .querySelectorAll('.control-section')
                .forEach(el => {
                    el.classList.add('d-none');
                });


            const target = document.getElementById(
                `section-${section}`
            );

            if (target) {
                target.classList.remove('d-none');
            }


            document
                .querySelectorAll('.sidebar-link')
                .forEach(el => {
                    el.classList.remove('active');
                });


            if (button) {
                button.classList.add('active');
            }


            document.getElementById('pageTitle').textContent =
                sectionTitles[section] || 'Control Panel';


            /*
             * Load data only when section is opened.
             */

            if (section === 'ports') {
                getUsedPorts();
            }

            if (section === 'webroot') {
                browseWebRoot('/var/www/html');
            }

            if (section === 'vhosts') {
                getVirtualHostsList();
            }

            if (section === 'nodeapps') {
                getNodeApps();
            }


            /*
             * Close mobile sidebar
             */

            document
                .getElementById('controlSidebar')
                .classList.remove('show');

            document
                .getElementById('sidebarOverlay')
                .classList.remove('show');

        }


        function switchSectionByName(section) {

            const button = document.querySelector(
                `.sidebar-link[data-section="${section}"]`
            );

            switchSection(section, button);

        }


        /* =========================================
           MOBILE SIDEBAR
        ========================================== */

        document
            .getElementById('mobileMenuButton')
            .addEventListener('click', function () {

                document
                    .getElementById('controlSidebar')
                    .classList.add('show');

                document
                    .getElementById('sidebarOverlay')
                    .classList.add('show');

            });


        document
            .getElementById('sidebarOverlay')
            .addEventListener('click', function () {

                document
                    .getElementById('controlSidebar')
                    .classList.remove('show');

                document
                    .getElementById('sidebarOverlay')
                    .classList.remove('show');

            });


        /* =========================================
           SYSTEM STATS
        ========================================== */

        const uptime =
            document.getElementById('uptime');

        const memStat =
            document.getElementById('memStat');

        const memDetail =
            document.getElementById('memDetail');

        const cpuStat =
            document.getElementById('cpuStat');


        /* =========================================
           CPU CHART
        ========================================== */

        const cpuChart = new Chart(
            document.getElementById('cpuChart'),
            {

                type: 'line',

                data: {

                    labels: [],

                    datasets: [{

                        label: 'CPU Usage',

                        data: [],

                        borderColor: '#58a6ff',

                        backgroundColor:
                            'rgba(88, 166, 255, 0.10)',

                        borderWidth: 2,

                        fill: true,

                        tension: 0.4,

                        pointRadius: 2,

                        pointHoverRadius: 5

                    }]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    animation: false,

                    plugins: {

                        legend: {
                            display: false
                        },

                        tooltip: {

                            callbacks: {

                                label: function (context) {

                                    return `CPU: ${Number(
                                        context.raw
                                    ).toFixed(1)}%`;

                                }

                            }

                        }

                    },

                    scales: {

                        x: {
                            display: false
                        },

                        y: {

                            min: 0,

                            max: 100,

                            ticks: {

                                color: '#8b949e',

                                callback: function (value) {
                                    return value + '%';
                                }

                            },

                            grid: {

                                color:
                                    'rgba(255,255,255,0.05)'

                            }

                        }

                    }

                }

            }
        );


        /* =========================================
           MEMORY CHART
        ========================================== */

        const memoryChart = new Chart(
            document.getElementById('memoryChart'),
            {

                type: 'line',

                data: {

                    labels: [],

                    datasets: [{

                        label: 'Memory Usage',

                        data: [],

                        borderColor: '#f0ad4e',

                        backgroundColor:
                            'rgba(240, 173, 78, 0.10)',

                        borderWidth: 2,

                        fill: true,

                        tension: 0.4,

                        pointRadius: 2,

                        pointHoverRadius: 5

                    }]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    animation: false,

                    plugins: {

                        legend: {
                            display: false
                        },

                        tooltip: {

                            callbacks: {

                                label: function (context) {

                                    return `Memory: ${Number(
                                        context.raw
                                    ).toFixed(1)}%`;

                                }

                            }

                        }

                    },

                    scales: {

                        x: {
                            display: false
                        },

                        y: {

                            min: 0,

                            max: 100,

                            ticks: {

                                color: '#8b949e',

                                callback: function (value) {
                                    return value + '%';
                                }

                            },

                            grid: {

                                color:
                                    'rgba(255,255,255,0.05)'

                            }

                        }

                    }

                }

            }
        );


        /* =========================================
           GET SYSTEM STATS
        ========================================== */

        function updateSystemStats() {

            fetch('/getUptime')
                .then(res => {

                    if (!res.ok) {
                        throw new Error('Failed to fetch uptime');
                    }

                    return res.text();

                })
                .then(data => {

                    uptime.innerHTML = data;

                })
                .catch(err => {

                    console.error(
                        'Uptime Error:',
                        err
                    );

                });


            fetch('/getSystemStats')
                .then(res => {

                    if (!res.ok) {
                        throw new Error(
                            'Failed to fetch system stats'
                        );
                    }

                    return res.json();

                })
                .then(data => {

                    /* -------------------------
                       CPU
                    ------------------------- */

                    const cpu =
                        Number(data.cpu.current);

                    cpuStat.innerHTML =
                        `${cpu.toFixed(1)}%`;


                    cpuChart.data.labels =
                        data.labels || [];

                    cpuChart.data.datasets[0].data =
                        data.cpu.history || [];

                    cpuChart.update('none');


                    /* -------------------------
                       MEMORY
                    ------------------------- */

                    const memory =
                        Number(data.memory.usagePercent);


                    memStat.innerHTML =
                        `${memory.toFixed(1)}%`;


                    const usedGB =
                        Number(data.memory.used)
                        / 1024
                        / 1024
                        / 1024;


                    const totalGB =
                        Number(data.memory.total)
                        / 1024
                        / 1024
                        / 1024;


                    memDetail.innerHTML =
                        `${usedGB.toFixed(1)} GB / ${totalGB.toFixed(1)} GB`;


                    memoryChart.data.labels =
                        data.labels || [];

                    memoryChart.data.datasets[0].data =
                        data.memory.history || [];

                    memoryChart.update('none');

                })
                .catch(err => {

                    console.error(
                        'System Stats Error:',
                        err
                    );

                });

        }


        updateSystemStats();

        setInterval(
            updateSystemStats,
            10000
        );


        /* =========================================
           USED PORTS
        ========================================== */

        function getUsedPorts() {

            const container =
                document.getElementById('used_ports');


            container.innerHTML =
                '<div class="loader"></div>';


            fetch('/getUsedPorts')
                .then(res => {

                    if (!res.ok) {
                        throw new Error(
                            'Failed to fetch used ports'
                        );
                    }

                    return res.text();

                })
                .then(data => {

                    container.innerHTML = data;

                })
                .catch(err => {

                    container.innerHTML = `
                        <div class="text-danger">
                            <i class="fa-solid fa-circle-exclamation me-2"></i>
                            Failed to load used ports.
                        </div>
                    `;

                    console.error(err);

                });

        }


        /* =========================================
           WEB ROOT
        ========================================== */

        function browseWebRoot(path) {

            const safePath =
                path || '/var/www/html';


            const container =
                document.getElementById(
                    'WebRootBrowser'
                );


            container.innerHTML =
                '<div class="loader"></div>';


            fetch(
                '/getWebRootBrowser?path=' +
                encodeURIComponent(safePath)
            )
                .then(res => {

                    if (!res.ok) {
                        throw new Error(
                            'Failed to fetch web root'
                        );
                    }

                    return res.text();

                })
                .then(data => {

                    container.innerHTML = data;

                })
                .catch(err => {

                    console.error(err);

                });

        }


        function openWebFile(path) {

            window.location.href =
                '/view-file?path=' +
                encodeURIComponent(path);

        }


        /* =========================================
           VIRTUAL HOSTS
        ========================================== */

        function getVirtualHostsList() {

            const container =
                document.getElementById(
                    'VirtualHostsList'
                );


            container.innerHTML =
                '<div class="loader"></div>';


            fetch('/getVirtualHostsList')
                .then(res => {

                    if (!res.ok) {
                        throw new Error(
                            'Failed to fetch virtual hosts'
                        );
                    }

                    return res.text();

                })
                .then(data => {

                    container.innerHTML = data;

                })
                .catch(err => {

                    container.innerHTML = `
                        <div class="p-4 text-danger">
                            Failed to load Virtual Hosts.
                        </div>
                    `;

                    console.error(err);

                });

        }


        /* =========================================
           NODE APPS
        ========================================== */

        function getNodeApps() {

            const container =
                document.getElementById(
                    'NodeAppsList'
                );


            container.innerHTML =
                '<div class="loader"></div>';


            fetch('/getNodeApps')
                .then(res => {

                    if (!res.ok) {
                        throw new Error(
                            'Failed to fetch Node Apps'
                        );
                    }

                    return res.text();

                })
                .then(data => {

                    container.innerHTML = data;

                })
                .catch(err => {

                    console.error(err);

                });

        }


        /* =========================================
           NGINX CONTROLS
        ========================================== */

        function restartNginx() {

            fetch('/restart')
                .then(res => {

                    if (!res.ok) {
                        throw new Error(
                            'Restart failed'
                        );
                    }

                    return res.text();

                })
                .then(() => {

                    Swal.fire({

                        title:
                            'Nginx is restarting!',

                        text:
                            'Web server restart command has been sent.',

                        icon: 'success',

                        background: '#161b22',

                        color: '#fff',

                        confirmButtonColor:
                            '#238636'

                    });

                })
                .catch(err => {

                    Swal.fire({

                        title: 'Restart Failed',

                        text: err.message,

                        icon: 'error',

                        background: '#161b22',

                        color: '#fff'

                    });

                });

        }


        function stopNginx() {

            if (
                !confirm(
                    'Do you want to stop web server?'
                )
            ) {
                return;
            }


            window.location.href = '/stop';

        }


        /* =========================================
           NODE APP CONTROLS
        ========================================== */

        const swalConfig = {

            background: '#161b22',

            color: '#fff',

            confirmButtonColor: '#238636'

        };


        function startNodeApp(name) {

            fetch('/start/node/' + name)

                .then(res => {

                    if (!res.ok) {
                        throw new Error(
                            'Failed to start application'
                        );
                    }

                    return res.json();

                })

                .then(data => {

                    Swal.fire({

                        ...swalConfig,

                        title: data.message,

                        text:
                            `${data.subject} has been started.`,

                        icon: 'success'

                    });

                    getNodeApps();

                })

                .catch(err => {

                    console.error(err);

                });

        }


        function stopNodeApp(name) {

            fetch('/stop/node/' + name)

                .then(res => {

                    if (!res.ok) {
                        throw new Error(
                            'Failed to stop application'
                        );
                    }

                    return res.json();

                })

                .then(data => {

                    Swal.fire({

                        ...swalConfig,

                        title: data.message,

                        text:
                            `${data.subject} has been stopped.`,

                        icon: 'success'

                    });

                    getNodeApps();

                })

                .catch(err => {

                    console.error(err);

                });

        }


        function restartNodeApp(name) {

            fetch('/restart/node/' + name)

                .then(res => {

                    if (!res.ok) {
                        throw new Error(
                            'Failed to restart application'
                        );
                    }

                    return res.json();

                })

                .then(data => {

                    Swal.fire({

                        ...swalConfig,

                        title: data.message,

                        text:
                            `${data.subject} has been restarted.`,

                        icon: 'success'

                    });

                    getNodeApps();

                })

                .catch(err => {

                    console.error(err);

                });

        }


        function pm2Save() {

            fetch('/pm2/save')

                .then(res => {

                    if (!res.ok) {
                        throw new Error(
                            'PM2 save failed'
                        );
                    }

                    return res.text();

                })

                .then(data => {

                    Swal.fire({

                        ...swalConfig,

                        title: data,

                        icon: 'success'

                    });

                })

                .catch(err => {

                    console.error(err);

                });

        }


        /* =========================================
           INITIAL LOAD
        ========================================== */

        getUsedPorts();

        browseWebRoot('/var/www/html');

        getVirtualHostsList();

        getNodeApps();

    </script>


    <%-include('include/footer')%>


            <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
                crossorigin="anonymous"></script>

</body>