<head>
    <title>Control Panel | Nginx Virtual Host Management System</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Prompt:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap');

        :root {
            --bg-body: #0d1117;
            --bg-card: #161b22;
            --bg-input: #0d1117;
            --border-color: #30363d;
            --accent-blue: #58a6ff;
            --text-main: #c9d1d9;
            --text-heading: #f0f6fc;
        }

        * {
            font-family: 'Prompt', sans-serif;
        }

        body {
            background-color: var(--bg-body) !important;
            color: var(--text-main);
        }

        /* Card Customization */
        .card {
            background-color: var(--bg-card) !important;
            border: 1px solid var(--border-color) !important;
            border-radius: 12px !important;
            color: var(--text-main) !important;
            box-shadow: 0 8px 24px rgba(0,0,0,0.3);
        }

        .card-header {
            background-color: rgba(255, 255, 255, 0.02) !important;
            border-bottom: 1px solid var(--border-color) !important;
            color: var(--text-heading) !important;
            font-weight: 600;
        }

        /* Input Controls */
        .form-control, .form-select {
            background-color: var(--bg-input) !important;
            color: var(--text-heading) !important;
            border: 1px solid var(--border-color) !important;
            border-radius: 8px;
            padding: 0.6rem 0.9rem;
        }

        .form-control:focus {
            border-color: var(--accent-blue) !important;
            box-shadow: 0 0 0 0.25rem rgba(88, 166, 255, 0.2) !important;
        }

        .form-control::placeholder {
            color: #8b949e !important;
        }

        /* Stat Boxes */
        .stat-card {
            background-color: var(--bg-input);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 1rem;
            height: 100%;
        }

        /* Custom Pulse Loader */
        .loader {
            width: 50px;
            aspect-ratio: 4;
            --_g: no-repeat radial-gradient(circle closest-side, var(--accent-blue) 90%, #0000);
            background: 
                var(--_g) 0%   50%,
                var(--_g) 50%  50%,
                var(--_g) 100% 50%;
            background-size: calc(100%/3) 100%;
            animation: l7 1s infinite linear;
            margin: 30px auto;
        }
        @keyframes l7 {
            33%{background-size:calc(100%/3) 0%  ,calc(100%/3) 100%,calc(100%/3) 100%}
            50%{background-size:calc(100%/3) 100%,calc(100%/3) 0%  ,calc(100%/3) 100%}
            66%{background-size:calc(100%/3) 100%,calc(100%/3) 100%,calc(100%/3) 0%  }
        }

        @media screen and (max-width: 1024px) {
            table {
                width: max-content;
            }
        }
    </style>
    <%-include('include/head')%>
</head>
<body>

    <!-- Alert Section -->
    <div class="container px-4 mt-3">
        <%if(locals.alert) {%>
            <div class="alert alert-success alert-dismissible fade show border-0 bg-success bg-opacity-20" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i><%=alert%>
                <script>
                    function removeAlert() {
                        window.history.replaceState(null, '', window.location.pathname);
                    }
                </script>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close" onclick="removeAlert()"></button>
            </div>
        <%}%>
    </div>

    <!-- Main Server Control Panel -->
    <div class="container px-4 my-4">
        <div class="card mb-4">
            <div class="card-header p-3 d-flex align-items-center">
                <i class="fa-solid fa-gears text-primary me-2 fa-lg"></i>
                <h5 class="m-0 fw-bold">Nginx Web Server Control Panel</h5>
            </div>
            <div class="card-body p-4">
                
                <!-- Server Metrics Overview -->
                <div class="mb-4">
                    <h6 class="text-uppercase text-secondary fw-semibold small mb-3">
                        <i class="fa-solid fa-server me-2"></i>System Status
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="stat-card">
                                <div class="text-secondary small mb-1"><i class="fa-solid fa-microchip me-2 text-info"></i>CPU Usage</div>
                                <div class="fs-5 fw-bold text-white" id="cpuStat">Loading...</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-card">
                                <div class="text-secondary small mb-1"><i class="fa-solid fa-memory me-2 text-warning"></i>Memory Usage</div>
                                <div class="fs-5 fw-bold text-white" id="memStat">Loading...</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-card">
                                <div class="text-secondary small mb-1"><i class="fa-regular fa-clock me-2 text-success"></i>System Uptime</div>
                                <div class="fs-5 fw-bold text-white" id="uptime">Loading...</div>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                    const uptime = document.getElementById('uptime')
                    const memStat = document.getElementById('memStat')
                    const cpuStat = document.getElementById('cpuStat')
        
                    function getSystemStat() {
                        fetch('/getUptime').then((res) => {
                            if(res.ok) return res.text()
                        }).then((data) => { uptime.innerHTML = data })

                        fetch('/getMemoryStat').then((res) => {
                            if(res.ok) return res.text()
                        }).then((data) => { memStat.innerHTML = data })

                        fetch('/getCPUusage').then((res) => {
                            if(res.ok) return res.text()
                        }).then((data) => { cpuStat.innerHTML = data })
                    }
        
                    getSystemStat()
                    setInterval(getSystemStat, 10000)
                </script>

                <!-- Action Controls -->
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <button class="btn btn-primary w-100 py-2 fw-medium" onclick="
                        fetch('/restart').then((res) => {
                            if(res.ok) return res.text()
                        }).then((data) => {
                            Swal.fire({
                                title: 'Nginx is restarting!',
                                icon: 'success',
                                background: '#161b22',
                                color: '#fff'
                            })
                            window.location.href = '/?alert=Restart Success.';
                        })">
                            <i class="fa-solid fa-arrows-rotate me-2"></i> Restart Web Server
                        </button>
                    </div>
                    <div class="col-sm-6">
                        <button class="btn btn-outline-danger w-100 py-2 fw-medium" onclick="if(confirm('Do you want to stop web server ?')) {window.location.href='/stop'}">
                            <i class="fa-solid fa-power-off me-2"></i> Stop Web Server
                        </button>
                    </div>
                </div>

                <!-- Create Virtual Host Actions -->
                <div class="d-flex flex-wrap gap-2 pt-2 border-top border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-light btn-sm px-3" data-bs-toggle="modal" data-bs-target="#nodejsvhost">
                        <i class="fa-brands fa-node-js me-2 text-success"></i> Create Node.js Virtual Host
                    </button>
                    <button type="button" class="btn btn-outline-light btn-sm px-3" data-bs-toggle="modal" data-bs-target="#phpvhost">
                        <i class="fa-brands fa-php me-2 text-info"></i> Create PHP Virtual Host
                    </button>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-5">
                <!-- Used Ports Section -->
                <div class="card h-100 p-4">
                    <div class="card-header p-3">
                        <h5 class="m-0 fw-bold"><i class="fa-solid fa-network-wired me-2 text-warning"></i>Used Ports</h5>
                    </div>
                    <div class="card-body p-4" id="used_ports">
                        <div class="loader"></div>
                    </div>
                    <script>
                        function getUsedPorts() {
                            fetch('/getUsedPorts').then(res => {
                                if(!res.ok) throw new Error('Fail to fetch.')
                                return res.text()
                            }).then(data => {
                                document.getElementById('used_ports').innerHTML = data
                            }).catch(err => {
                                alert(err)
                            })
                        }
                        getUsedPorts()
                    </script>
                </div>
            </div>

            <!-- Web Root Browser -->
            <div class="col-lg-7">
                <div class="card h-100 p-4">
                    <div id="WebRootBrowser">
                        <div class="loader"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Applications & Virtual Hosts Grid -->
        <div class="row g-4 mb-4">

            <!-- Virtual Hosts List -->
            <div class="col-lg-6">
                <div class="card h-100 p-4" id="VirtualHostsList">
                    <div class="loader"></div>
                </div>
            </div>
            <script>
                function getVirtualHostsList() {
                    fetch('/getVirtualHostsList').then(res => {
                        if(!res.ok) throw new Error('Fail to fetch.')
                        return res.text()
                    }).then(data => {
                        document.getElementById('VirtualHostsList').innerHTML = data
                    }).catch(err => {
                        alert(err)
                    })
                }
                getVirtualHostsList()
            </script>

            <!-- Node Apps List -->
            <div class="col-lg-6">
                <div class="card h-100 p-4">
                    <div id="NodeAppsList">
                        <div class="loader"></div>
                    </div>
                </div>
            </div>

            <script>
                function getNodeApps() {
                    fetch('/getNodeApps').then(res => {
                        if(!res.ok) throw new Error('Fail to fetch.')
                        return res.text()
                    }).then(data => {
                        document.getElementById('NodeAppsList').innerHTML = data
                    }).catch(err => {
                        console.log(err)
                    })
                }

                function browseWebRoot(path) {
                    const safePath = path || '/var/www/html'
                    fetch('/getWebRootBrowser?path=' + encodeURIComponent(safePath)).then(res => {
                        if(!res.ok) throw new Error('Fail to fetch.')
                        return res.text()
                    }).then(data => {
                        document.getElementById('WebRootBrowser').innerHTML = data
                    }).catch(err => {
                        console.log(err)
                    })
                }

                function openWebFile(path) {
                    window.location.href = '/view-file?path=' + encodeURIComponent(path)
                }

                getNodeApps()
                browseWebRoot('/var/www/html')
            </script>
        </div>
    </div>

    <!-- Node.js VHost Modal -->
    <div class="modal fade" id="nodejsvhost" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content card border-0">
                <div class="modal-header border-bottom border-secondary border-opacity-25 p-3">
                    <h5 class="modal-title text-white"><i class="fa-brands fa-node-js text-success me-2"></i> Create Node.js Virtual Host</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form action="/createNodeJSVirtualHost" method="post">
                        <h6 class="text-primary mb-3"><i class="fa-solid fa-globe me-2"></i>App Settings</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small text-secondary">App name:</label>
                                <input type="text" class="form-control" name="app_name" placeholder="my-node-app" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-secondary">Port:</label>
                                <input type="number" class="form-control" name="port" placeholder="3000" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-secondary">Server Name (Domain):</label>
                                <input type="text" class="form-control" name="server_name" placeholder="app.example.com" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-secondary">Node.js Path:</label>
                                <input type="text" class="form-control" name="app_path" placeholder="/var/www/node-app">
                            </div>
                        </div>

                        <h6 class="text-primary my-3"><i class="fa-solid fa-hard-drive me-2"></i>Resources</h6>
                        <div class="mb-3">
                            <label class="form-label small text-secondary">Resource Folders (comma separated):</label>
                            <input type="text" class="form-control" name="folders" placeholder="css,js,images,videos">
                        </div>

                        <h6 class="text-primary my-3"><i class="fa-solid fa-shield-halved me-2"></i>SSL Settings</h6>
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input bg-dark border-secondary" value="true" name="ssl_enabled" id="node_ssl">
                            <label class="form-check-label small text-secondary" for="node_ssl">Enable SSL</label>
                        </div>
                        <div class="mb-4">
                            <label class="form-label small text-secondary">SSL File Name:</label>
                            <input type="text" class="form-control" name="ssl_file_name" placeholder="e.g. example_com">
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2"><i class="fa-solid fa-plus me-2"></i> Create Virtual Host</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- PHP VHost Modal -->
    <div class="modal fade" id="phpvhost" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content card border-0">
                <div class="modal-header border-bottom border-secondary border-opacity-25 p-3">
                    <h5 class="modal-title text-white"><i class="fa-brands fa-php text-info me-2"></i> Create PHP Virtual Host</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form action="/createPHPVirtualHost" method="post">
                        <h6 class="text-primary mb-3"><i class="fa-solid fa-globe me-2"></i>App Settings</h6>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small text-secondary">App name:</label>
                                <input type="text" class="form-control" name="app_name" placeholder="my-php-app" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-secondary">PHP Version:</label>
                                <input type="text" class="form-control" name="php_version" placeholder="8.1" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-secondary">Server Name (Domain):</label>
                                <input type="text" class="form-control" name="server_name" placeholder="php.example.com" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-secondary">Root Directory:</label>
                                <input type="text" class="form-control" name="root_dir" placeholder="/var/www/html/my-app" required>
                            </div>
                        </div>

                        <h6 class="text-primary my-3"><i class="fa-solid fa-shield-halved me-2"></i>SSL Settings</h6>
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input bg-dark border-secondary" value="true" name="ssl_enabled" id="php_ssl">
                            <label class="form-check-label small text-secondary" for="php_ssl">Enable SSL</label>
                        </div>
                        <div class="mb-4">
                            <label class="form-label small text-secondary">SSL File Name:</label>
                            <input type="text" class="form-control" name="ssl_file_name" placeholder="e.g. example_com">
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2"><i class="fa-solid fa-plus me-2"></i> Create Virtual Host</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts Operations -->
    <script>
        const swalConfig = {
            background: '#161b22',
            color: '#fff',
            confirmButtonColor: '#238636'
        };

        function startNodeApp(name) {
            fetch('/start/node/'+name).then(res => {
                if(!res.ok) throw new Error('Fail to fetch.')
                return res.text()
            }).then(data => {
                Swal.fire({ ...swalConfig, title: data, icon: 'success' })
                getNodeApps()
            }).catch(err => console.log(err))
        }

        function stopNodeApp(name) {
            fetch('/stop/node/'+name).then(res => {
                if(!res.ok) throw new Error('Fail to fetch.')
                return res.text()
            }).then(data => {
                Swal.fire({ ...swalConfig, title: data, icon: 'success' })
                getNodeApps()
            }).catch(err => console.log(err))
        }

        function restartNodeApp(name) {
            fetch('/restart/node/'+name).then(res => {
                if(!res.ok) throw new Error('Fail to fetch.')
                return res.text()
            }).then(data => {
                Swal.fire({ ...swalConfig, title: data, icon: 'success' })
                getNodeApps()
            }).catch(err => console.log(err))
        }

        function pm2Save() {
            fetch('/pm2/save').then(res => {
                if(!res.ok) throw new Error('Fail to fetch.')
                return res.text()
            }).then(data => {
                Swal.fire({ ...swalConfig, title: data, icon: 'success' })
            }).catch(err => console.log(err))
        }
    </script>

    <%-include('include/footer')%>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>