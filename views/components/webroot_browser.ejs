<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3 class="mb-0"><i class="fa-solid fa-folder-tree me-2 text-info"></i> Web Root Browser</h3>
    <div class="text-secondary small">
        <i class="fa-solid fa-location-dot me-2"></i><%= currentPath %>
    </div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <% if (canGoUp) { %>
        <button class="btn btn-sm btn-outline-light" onclick="browseWebRoot('<%= parentPath %>')">
            <i class="fa-solid fa-arrow-up me-2"></i> Up
        </button>
    <% } %>
    <button class="btn btn-sm btn-outline-light" onclick="browseWebRoot('<%= rootBase %>')">
        <i class="fa-solid fa-house me-2"></i> Root
    </button>
</div>

<div class="list-group" style="max-height: 400px; overflow: auto;">
    <% items.forEach((item) => { %>
        <div class="list-group-item list-group-item-dark border-secondary bg-transparent d-flex justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3" style="cursor: pointer;" onclick="<%= item.isDirectory ? `browseWebRoot('${item.path.replace(/'/g, "\\'")}')` : `openWebFile('${item.path.replace(/'/g, "\\'")}')` %>">
                <i class="fa-solid <%= item.icon %> <%= item.isDirectory ? 'text-warning' : 'text-light' %>"></i>
                <span class="text-white"><%= item.name %></span>
            </div>
            <% if (!item.isDirectory) { %>
                <button class="btn btn-sm btn-outline-primary" onclick="openWebFile('<%= item.path.replace(/'/g, "\\'") %>')">
                    <i class="fa-solid fa-pen-to-square"></i>
                </button>
            <% } %>
        </div>
    <% }) %>
</div>
